{
    "name": "myvendor/getusersservice",
    "description": "Microservice in PHP to get users with JWT authentication and connection to MongoDB",
    "require": {
        "slim/slim": "^4.0",
        "mongodb/mongodb": "^1.9",
        "firebase/php-jwt": "^6.3",
        "slim/psr7": "^1.5",
        "vlucas/phpdotenv": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    }
}
